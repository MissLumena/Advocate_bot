TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Основной провайдер для проекта: DeepSeek.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI можно оставить как резервный вариант.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# GigaChat выключен по умолчанию.
# GIGACHAT_CREDENTIALS=
# GIGACHAT_MODEL=

# Если ни один ключ не задан, бот работает в офлайн-режиме и отвечает шаблонами.

# RAG: OpenAI используется только для эмбеддингов, Supabase — для pgvector.
# OPENAI_API_KEY=your_openai_api_key_here
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=5

# Нужно только для запуска через вебхук (WEBHOOK_MODE=true)
# WEBHOOK_MODE=false
# WEBHOOK_URL=https://your-domain.example
# PORT=8443