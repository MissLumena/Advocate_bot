TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Заполните ОДИН из вариантов ниже (не оба обязательны).
# Если задан OPENAI_API_KEY — используется OpenAI, DEEPSEEK_API_KEY при этом игнорируется.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat

# Если оба ключа не заданы (или начинаются с "your_"), бот работает
# в офлайн-режиме и отвечает шаблонами на основе ключевых слов.

# Нужно только для запуска через вебхук (WEBHOOK_MODE=true)
# WEBHOOK_MODE=false
# WEBHOOK_URL=https://your-domain.example
# PORT=8443